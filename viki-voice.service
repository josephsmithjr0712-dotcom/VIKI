[Unit]
Description=VIKI hands-free voice loop (wake word)
After=network.target viki-server.service

[Service]
Type=simple
WorkingDirectory=/opt/viki
EnvironmentFile=/opt/viki/.env
ExecStart=/opt/viki/.venv/bin/python voice_loop.py
Restart=always
RestartSec=5
# Needs access to the mic/speakers
SupplementaryGroups=audio

[Install]
WantedBy=multi-user.target
